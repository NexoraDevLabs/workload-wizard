{
  "name": "workload-wizard",
  "version": "0.4.1",
  "private": true,
  "description": "WorkloadWizard web application",
  "author": "@NexoraDevLabs",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm exec next dev",
    "dev:clean": "rimraf .next && pnpm exec next dev",
    "build": "pnpm exec next build",

    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fix": "eslint . --fix && prettier -w .",

    "start": "pnpm exec next start",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "test": "pnpm exec vitest run --passWithNoTests",
    "test:watch": "pnpm exec vitest --passWithNoTests",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "commitlint": "commitlint --edit $1",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "precommit:all": "sh -c 'if [ -z \"$SKIP_CHECKS\" ]; then pnpm typecheck && pnpm lint && pnpm test; else echo \"SKIP_CHECKS=1 -> skipping typecheck/lint/test\"; fi'",
    "commit": "git add -A && pnpm precommit:all && pnpm exec czg && git push -u origin HEAD",
    "commit:msg": "git add -A && pnpm precommit:all && pnpm exec czg -m \"$@\" && git push -u origin HEAD",
    "clean": "rimraf node_modules .next dist coverage && pnpm store prune",
    "update:all": "pnpm update --latest --recursive",
    "doctor": "pnpm dlx pnpm@10.15.0 doctor || true",
    "reset": "pnpm clean && pnpm install && pnpm check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css,scss,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "czg"
    }
  },
  "dependencies": {
    "@clerk/backend": "^2.10.1",
    "@clerk/nextjs": "^6.31.6",
    "@flags-sdk/statsig": "^0.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^4.6.0",
    "@sentry/nextjs": "^10.7.0",
    "@statsig/react-bindings": "^3.24.4",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.26.2",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.542.0",
    "next": "15.5.2",
    "next-sanity": "^10.0.15",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.261.0",
    "react": "19.1.1",
    "react-day-picker": "^9.9.0",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^3.0.5",
    "recharts": "^3.1.2",
    "resend": "^6.0.1",
    "sanity": "^4.6.0",
    "sonner": "^2.0.7",
    "styled-components": "^6.1.19",
    "svix": "^1.75.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@clerk/types": "^4.83.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.34.0",
    "@next/bundle-analyzer": "^15.5.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "czg": "^1.12.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.34.0",
    "eslint-config-next": "15.5.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.5",
    "madge": "^8.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "cookie": ">=0.7.0"
    },
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@sentry/cli",
      "@tailwindcss/oxide",
      "@vercel/speed-insights",
      "core-js",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "trustedDependencies": [
      "@sentry/cli",
      "@vercel/speed-insights"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    }
  }
}
