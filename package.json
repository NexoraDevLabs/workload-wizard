{
  "name": "workload-wizard",
  "version": "0.4.1",
  "private": true,
  "description": "WorkloadWizard web application",
  "author": "@NexoraDevLabs",
  "license": "MIT",
  "type": "module",
  "//": "TODO: Remove the build script NODE_OPTIONS memory flag after dependency and build complexity is reduced.",
  "engines": {
    "node": ">=20.11.0 <21"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm exec next dev",
    "dev:all": "concurrently \"pnpm exec next dev\" \"pnpm exec convex dev\"",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' pnpm exec next build",
    "start": "pnpm exec next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm exec vitest run --passWithNoTests",
    "test:watch": "pnpm exec vitest --passWithNoTests",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yml,yaml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "czg"
    }
  },
  "dependencies": {
    "@clerk/backend": "^2.33.3",
    "@clerk/nextjs": "^6.39.3",
