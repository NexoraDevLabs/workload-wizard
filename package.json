    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "globby": "^14.1.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.20.5",
