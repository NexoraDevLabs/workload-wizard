# ------------------------------------------------------------------------------
# Default behaviour
# ------------------------------------------------------------------------------

# Auto-normalise line endings to LF on commit, checkout as native
* text=auto eol=lf

# Ensure all files with these extensions are always treated as text
*.js      text
*.jsx     text
*.ts      text
*.tsx     text
*.json    text
*.yml     text
*.yaml    text
*.css     text
*.scss    text
*.md      text
*.html    text
*.cjs     text
*.mjs     text

# ------------------------------------------------------------------------------
# Binary files (prevent Git from modifying line endings)
# ------------------------------------------------------------------------------
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.svg     binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.zip     binary
*.gz      binary
*.tar     binary
*.mp4     binary
*.mp3     binary
*.mov     binary
*.pdf     binary

# ------------------------------------------------------------------------------
# GitHub Linguist overrides (optional, improves repo stats)
# ------------------------------------------------------------------------------
# Mark lock files as generated
package-lock.json linguist-generated
pnpm-lock.yaml    linguist-generated
yarn.lock         linguist-generated

# Ignore built/compiled output
dist/*            linguist-generated
.next/*           linguist-generated
out/*             linguist-generated

# ------------------------------------------------------------------------------
# Diff settings (improves readability for certain file types)
# ------------------------------------------------------------------------------
*.md      diff=markdown
*.mdx     diff=markdown
*.css     diff=css
*.scss    diff=css
*.html    diff=html
*.json    diff=json
*.yml     diff=yaml
*.yaml    diff=yaml
